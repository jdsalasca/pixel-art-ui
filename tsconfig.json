{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "packages/pixel-ui/src",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["packages/pixel-ui/src/**/*.ts", "packages/pixel-ui/src/**/*.tsx"]
}
